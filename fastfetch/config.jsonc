{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "duration": {
      "abbreviation": true
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{name} {codename} {version} {arch}"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "display",
      "key": "Display",
      "format": "{width}x{height} @ {refresh-rate}Hz ({inch}\")"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name} (with {plugin-name})"
    },
    "wmtheme",
    "theme",
    {
      "type": "font",
      "format": "{font1}"
    },
    "terminal",
    "terminalfont",
    "cpu",
    {
      "type": "gpu",
      "format": "{name} ({core-count}) @ {frequency}"
    },
    "memory",
    "swap",
    {
      "type": "disk",
      "key": "Disk (/)",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "format": "{ipv4}"
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{capacity} ({time-formatted}) [{status}]"
    },
    "locale",
    "break",
    "colors"
  ]
}
