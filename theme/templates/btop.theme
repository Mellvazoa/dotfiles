# Generated by theme.py ({{theme_label}})

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="{{island}}"

# Main text color
theme[main_fg]="{{fg_soft}}"

# Title color for boxes
theme[title]="{{fg}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent}}"

# Background and foreground color for selected item in processes box
theme[selected_bg]="{{bg2}}"
theme[selected_fg]="{{accent_light}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{fg_muted}}"

# Misc colors for processes box
theme[proc_misc]="{{lilac}}"

# Box outline and divider line colors
theme[cpu_box]="{{bg2}}"
theme[mem_box]="{{bg2}}"
theme[net_box]="{{bg2}}"
theme[proc_box]="{{bg2}}"
theme[div_line]="{{bg2}}"

# Temperature graph colors
theme[temp_start]="{{fg_muted}}"
theme[temp_mid]="{{orange}}"
theme[temp_end]="{{red}}"

# CPU graph colors
theme[cpu_start]="{{bg2}}"
theme[cpu_mid]="{{accent_dim}}"
theme[cpu_end]="{{accent}}"

# Mem/Disk free meter
theme[free_start]="{{bg2}}"
theme[free_mid]="{{fg_muted}}"
theme[free_end]="{{green}}"

# Mem/Disk cached meter
theme[cached_start]="{{bg2}}"
theme[cached_mid]="{{fg_muted}}"
theme[cached_end]="{{blue}}"

# Mem/Disk available meter
theme[available_start]="{{bg2}}"
theme[available_mid]="{{fg_muted}}"
theme[available_end]="{{lilac}}"

# Mem/Disk used meter
theme[used_start]="{{bg2}}"
theme[used_mid]="{{accent_dim}}"
theme[used_end]="{{accent}}"

# Download graph colors
theme[download_start]="{{bg2}}"
theme[download_mid]="{{lilac}}"
theme[download_end]="{{accent_light}}"

# Upload graph colors
theme[upload_start]="{{bg2}}"
theme[upload_mid]="{{accent_dim}}"
theme[upload_end]="{{accent}}"
